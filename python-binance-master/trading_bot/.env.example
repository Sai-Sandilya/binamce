# =============================================================
#   ENVIRONMENT VARIABLES TEMPLATE
#   Copy this file to ".env" in the same folder and fill in
#   your REAL values. Never commit the ".env" file to git.
# =============================================================

# Binance API credentials
# Live keys:    https://www.binance.com/en/my/settings/api-management
# Testnet keys: https://testnet.binance.vision/
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Telegram bot notifications (optional)
# Create/regenerate a bot token via @BotFather on Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
